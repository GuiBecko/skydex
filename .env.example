# Copy to .env and adjust. `docker compose up` reads this file.

# --- Database -----------------------------------------------------------
# Host `db` is the compose service name; from outside compose use localhost.
URL_POSTGRES=jdbc:postgresql://db:5432/skydex
USUARIO_POSTGRES=postgres
SENHA_POSTGRES=postgres

# --- Auth ---------------------------------------------------------------
# CHANGE THIS. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_JWT_SECRET=change-me-before-running-anything-real

# --- Server -------------------------------------------------------------
SERVER_PORT=3002

# --- Photo storage ------------------------------------------------------
# Where uploaded captures are written inside the backend container.
PHOTO_STORAGE_DIR=/srv/data/photos
# How stored photos are addressed from outside. Stored paths are relative and
# this is composed in on the way out, so changing it never orphans a row.
PUBLIC_BASE_URL=http://localhost:3002

# --- Vision service -----------------------------------------------------
VISION_BASE_URL=http://vision:8000

# Stage 1: below this outdoor score an upload is refused with 422.
# Measured: on the 30-image golden set the worst fraud scores 0.0547 and the
# weakest real sky 0.7831, so 0.60 sits in a wide empty band.
VISION_OUTDOOR_MIN=0.60

# Stage 2: a photo/weather contradiction only blocks when the expected group
# scored below the first value AND the winning group scored above the second.
# These two are judgement, not measurement — there is no labelled set of
# contradiction pairs to derive them from. They are deliberately conservative.
VISION_EXPECTED_SCORE_MAX=0.10
VISION_TOP_SCORE_MIN=0.70
